{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JaySalamanka/maintengraph/main/schemas/config-v2.schema.json",
  "title": "MaintenGraph configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 2 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/column" },
        "parent": { "$ref": "#/$defs/column" },
        "name": { "$ref": "#/$defs/column" },
        "path": { "$ref": "#/$defs/column" },
        "level": { "$ref": "#/$defs/column" },
        "identity": { "$ref": "#/$defs/column" },
        "evidence": { "$ref": "#/$defs/column" },
        "reviewStatus": { "$ref": "#/$defs/column" },
        "objectClass": { "$ref": "#/$defs/column" },
        "legacyIds": { "$ref": "#/$defs/column" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rootPolicy": { "enum": ["any", "one"] },
        "maxDepth": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "requireParentBeforeChild": { "type": "boolean" },
        "pathSeparator": { "type": "string", "minLength": 1, "maxLength": 16 },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["off", "review", "release"] },
            "evidenceSeparator": { "type": "string", "minLength": 1, "maxLength": 16 },
            "legacyIdSeparator": { "type": "string", "minLength": 1, "maxLength": 16 },
            "forbidGenericBuckets": { "type": "boolean" }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "failOn": { "enum": ["error", "warning", "none"] } }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxBytesPerFile": { "type": "integer", "minimum": 1024, "maximum": 5000000 },
        "maxRowsPerFile": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "maxColumns": { "type": "integer", "minimum": 3, "maximum": 100 },
        "maxFieldLength": { "type": "integer", "minimum": 16, "maximum": 10000 },
        "maxFindings": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    }
  },
  "$defs": {
    "column": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}

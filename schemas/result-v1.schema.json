{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JaySalamanka/maintengraph/main/schemas/result-v1.schema.json",
  "title": "MaintenGraph deterministic result v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "findingCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "errors", "warnings", "notices"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "notices": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "required": ["schema_version", "tool", "config_sha256", "inputs", "gate", "comparison", "summary", "findings"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "ruleset"],
      "properties": {
        "name": { "const": "maintengraph" },
        "version": { "type": "string" },
        "ruleset": { "type": "string" }
      }
    },
    "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "rows"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "rows": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fail_on"],
      "properties": {
        "mode": { "enum": ["all", "new"] },
        "fail_on": { "enum": ["error", "warning", "none"] }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "new_findings", "resolved_findings", "unchanged_findings"],
      "properties": {
        "baseline": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "schema_version", "tool_version", "ruleset"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "schema_version": { "enum": ["1.0", "1.1"] },
                "tool_version": { "type": "string" },
                "ruleset": { "const": "asset-governance@2" }
              }
            }
          ]
        },
        "new_findings": { "$ref": "#/$defs/findingCounts" },
        "resolved_findings": { "$ref": "#/$defs/findingCounts" },
        "unchanged_findings": { "$ref": "#/$defs/findingCounts" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "rows", "score", "errors", "warnings", "notices", "passed", "operational_errors"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "notices": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" },
        "operational_errors": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "baseline_status", "rule_id", "severity", "field", "message", "suggestion", "location"],
        "properties": {
          "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "baseline_status": { "enum": ["new", "unchanged"] },
          "rule_id": { "type": "string", "pattern": "^ATC[0-9]{3}$" },
          "severity": { "enum": ["error", "warning", "notice"] },
          "asset_id": { "type": "string" },
          "field": { "type": "string" },
          "message": { "type": "string" },
          "suggestion": { "type": "string" },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line"],
            "properties": {
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
